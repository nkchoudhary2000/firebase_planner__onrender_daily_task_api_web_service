rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Daily Task Planner User Tokens & Cloud Sync Collection (Spark Plan Compatible)
    match /daily_task_planner_users/{userId} {
      allow read, write: if true;
    }
    
    // Fallback users collection
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Default rule for all other documents
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
